# ─── Microsoft Bot Framework / Azure Bot ───────────────────────────────
# From your Azure Bot registration (App Registration in Entra ID).
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
# "MultiTenant" (default) | "SingleTenant" | "UserAssignedMSI"
MICROSOFT_APP_TYPE=MultiTenant
# Required only when MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANT_ID=

# ─── BBB Desktop ticket endpoint (CreateTicket.ashx) ───────────────────
# Full URL of the endpoint you deploy inside the Desktop app (see desktop-endpoint/).
# Staging example:
DESKTOP_TICKET_API_URL=https://desktop.bbbappdev.com/api/CreateTicket.ashx

# Lookup endpoint (pick-lists for the interactive flow). Optional — defaults to
# the create URL with "CreateTicket.ashx" swapped for "DesktopLookups.ashx".
DESKTOP_LOOKUP_API_URL=https://desktop.bbbappdev.com/api/DesktopLookups.ashx

# Shared secret — must match Web.config "TeamsBot.ApiKey" on the Desktop app.
DESKTOP_TICKET_API_KEY=

# Base URL used to build a clickable ticket link in the Teams reply (append id).
DESKTOP_TICKET_WEB_BASE_URL=https://desktop.bbbappdev.com/Ticket/Detail2.aspx?Id=

# ─── Server ────────────────────────────────────────────────────────────
PORT=3978
