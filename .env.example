# ─── Microsoft Bot Framework / Azure Bot ───────────────────────────────
# From your Azure Bot registration (App Registration in Entra ID).
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
# "MultiTenant" (default) | "SingleTenant" | "UserAssignedMSI"
MICROSOFT_APP_TYPE=MultiTenant
# Required only when MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANT_ID=

# ─── BBB Desktop.Api ───────────────────────────────────────────────────
# Base URL. Defaults to STAGING if omitted.
#   Staging:    https://desktop-api.bbbappdev.com   (default)
#   Production: https://desktop-api.bitxbit.com
DESKTOP_API_BASE_URL=https://desktop-api.bbbappdev.com

# Service-account credentials used for POST /authenticate (e.g. desktop-www).
EXTERNAL_API_USERNAME=
EXTERNAL_API_PASSWORD=

# Base URL used to build a clickable ticket link in the Teams reply.
# Staging web front-end shown below; append the ticket id.
DESKTOP_TICKET_WEB_BASE_URL=https://desktop.bbbappdev.com/Ticket/Detail2.aspx?Id=

# ─── Server ────────────────────────────────────────────────────────────
PORT=3978
