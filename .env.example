# ─── Microsoft Bot Framework / Azure Bot ───────────────────────────────
# From your Azure Bot registration (App Registration in Entra ID).
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
# "MultiTenant" (default) | "SingleTenant" | "UserAssignedMSI"
MICROSOFT_APP_TYPE=MultiTenant
# Required only when MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANT_ID=

# ─── Teamwork Desk ─────────────────────────────────────────────────────
# Your Desk site, e.g. https://yourcompany.teamwork.com  (no trailing /desk)
TEAMWORK_DESK_BASE_URL=https://yourcompany.teamwork.com
# API key: Desk → avatar → View Profile → API Keys → create an API key
TEAMWORK_DESK_API_KEY=

# The inbox new tickets are created in. Find IDs via GET /desk/api/v2/inboxes.json
TEAMWORK_DESK_INBOX_ID=

# Fallback customer email used when the "client" value is not an email
# and no matching customer is found (a customer is created if needed).
DEFAULT_CUSTOMER_EMAIL=

# Optional defaults (numeric IDs). Leave blank to let Desk apply its defaults.
DEFAULT_STATUS_ID=
DEFAULT_PRIORITY_ID=

# ─── Server ────────────────────────────────────────────────────────────
PORT=3978
